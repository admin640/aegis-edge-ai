rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── Model Files ──
    // Anyone authenticated can download models (read-only).
    // Only admins can upload new model files.
    match /models/{modelFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    // ── Organization-scoped Files ──
    // Users can only read/write within their org's directory.
    match /orgs/{orgId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.orgId == orgId;
    }

    // ── Default: deny all ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
